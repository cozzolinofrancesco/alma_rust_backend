{
  "name": "googlehackaton-interface",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "__NEXT_DISABLE_MEMORY_WATCHER=1 NODE_OPTIONS='--max-old-space-size=8192' next dev -p 8080",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "eslint app pages --ext .js,.mjs,.cjs,.jsx,.ts,.mts,.cts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api-first": "node scripts/api/audit/api-first-audit.cjs",
    "test:api-first:headless": "node scripts/api/audit/api-first-audit.cjs --headless",
    "test:api-first:live-gates": "node scripts/api/audit/api-first-live-gates.mjs",
    "test:api:python": "python3 -B -m unittest discover -s scripts/api/python/tests -p 'test_*.py'",
    "test:scripts": "node --test scripts/api/audit/tests/*.test.cjs scripts/api/node/tests/*.test.mjs scripts/quality/tests/*.test.mjs",
    "test:all": "npm test && npm run test:scripts && npm run test:api:python",
    "verify": "npm test && npm run build",
    "verify:all": "npm run lint && npm run typecheck && npm run test:all && npm run build",
    "verify:full": "node scripts/quality/verify-pipeline.mjs",
    "update-models": "node scripts/models/update-models.mjs",
    "gen:welcome-images": "node scripts/assets/generate-welcome-images.mjs",
    "integrity:init": "node scripts/quality/integrity-check.js init",
    "integrity:check": "node scripts/quality/integrity-check.js check",
    "integrity:update": "node scripts/quality/integrity-check.js update",
    "integrity:summary": "node scripts/quality/integrity-check.js summary",
    "i18n:keys": "node scripts/i18n/check-i18n-keys.mjs",
    "i18n:keys:warn": "node scripts/i18n/check-i18n-keys.mjs --warn-identical",
    "i18n:audit": "node scripts/i18n/i18n-audit-customer-ui.mjs --write docs/i18n/customer-ui-i18n-backlog.md",
    "fix:latex": "node --no-warnings scripts/quality/fix-latex.mjs"
  },
