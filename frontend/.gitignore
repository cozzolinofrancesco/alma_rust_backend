# ------------------------------------------
.eslintcache
.stylelintcache
.prettiercache
.cache/

# ------------------------------------------
# Temporary files
# ------------------------------------------
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
*.swp
.temp/
.tmp/

# Project-specific temp directories
tmp_uploads_ocr/
/tmp_uploads_ocr/

# Runtime job/data store (kept on disk, not tracked)
.data/
scripts/docs/alma-commercial-materials/.local/
scripts/docs/alpacax-commercial-materials/.local/

