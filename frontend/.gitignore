# ==========================================
# GITIGNORE - Next.js / React / TypeScript
# ==========================================

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz
.venv/
__pycache__/
*.py[cod]

# ------------------------------------------
# Package manager caches
# ------------------------------------------
# npm
.npm/
.npm-cache/
npm-cache/
.npmrc.local
.cache/npm/

# yarn
.yarn/
.yarn-cache/
.yarnrc.local

# pnpm
.pnpm-store/
.pnpm/

# ------------------------------------------
# Build outputs
# ------------------------------------------
# Next.js
.next/
out/
.next/cache/

# Production build (keep build/reports if needed)
# build/
build/reports/

# Compiled output
dist/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ------------------------------------------
# Environment variables (NEVER commit secrets)
# ------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.template

# ------------------------------------------
