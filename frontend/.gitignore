.turbo/

# PWA files
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/sw.js.map
**/public/workbox-*.js.map

# Debug files
*.cpuprofile
*.heapsnapshot

# ------------------------------------------
# Project-specific
# ------------------------------------------
# Session/context tracking (AI assistant notes)
/context/

# Ideas and personal notes
/ideas/
/content/

# Email allow-list / any exported address list (never commit PII)
all_emails.txt
*_emails.txt

# Large test PDFs or temporary test files (moved to fixtures/)
fixtures/test_pdfs/test_evening/
fixtures/test_pdfs/test_evening/*.pdf

# Large binary files (if any)
*.zip
*.tar.gz
*.rar
*.7z

# SQLite databases (if used locally)
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Keep these files (overrides)
# ------------------------------------------
!.gitkeep
!.npmrc
!.nvmrc
!.node-version
